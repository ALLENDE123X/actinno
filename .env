# Actinno — .env (committed defaults, no secrets)
# Real secrets go in .env.local (gitignored) — see .env.example for what's needed

NEXT_PUBLIC_APP_NAME=Actinno

# Inngest runs against the local dev server (`npx inngest-cli dev`), not Inngest
# Cloud — the README's "local demo only" scope. This is a committed default
# rather than a per-machine setting because the SDK does NOT infer it: Inngest
# v4 ignores NODE_ENV and treats a missing INNGEST_DEV as cloud, where it then
# fails on the absent signing key. Set INNGEST_DEV= (empty) in .env.local, plus
# INNGEST_EVENT_KEY, to point at Cloud instead — .env.local is loaded first and
# dotenv never overwrites, so it wins.
INNGEST_DEV=1
