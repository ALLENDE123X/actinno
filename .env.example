# Copy to .env.local and fill in real values. .env.local is gitignored — never commit it.

# Apify — apify.com/settings/integrations
# Used by: bulk-search-job-listings (ACT-002, lib/search-job-listings.ts) only.
# ACT-005's browser automation moved off Apify to local Chromium in ACT-012 — see below.
#
# Note on what that search can do: the actor lists jobs for NAMED Greenhouse
# company boards ("stripe", "airbnb"). It has no keyword-search mode, so a job
# title is a filter over the results, not a query. See that file's header.
APIFY_API_TOKEN=

# Stagehand — the LLM key that drives browser automation (ACT-005 account creation).
# Model: openai/gpt-5.6-luna. An OpenAI API key, from platform.openai.com/api-keys.
# Deliberately its OWN key, not shared with any other project: this one pays for
# every page read on a real employer's job board and should be independently
# rotatable and independently billable.
STAGEHAND_LLM_API_KEY=

# Resume parsing + cover letter (ACT-007). OPTIONAL — falls back to
# STAGEHAND_LLM_API_KEY, which is the same provider and the same account.
#
# It has its own name because the two LLM surfaces in this pipeline are
# different trust domains, and it is worth being able to see them apart on a
# bill and rotate them apart. STAGEHAND_LLM_API_KEY pays for calls that DRIVE A
# BROWSER; this one pays for calls that are text-in/text-out with no tools
# attached and no ability to act — which is the only reason it is safe to feed
# them a candidate's resume text and a scraped job description. See
# lib/resume-parser.ts.
RESUME_LLM_API_KEY=

# Supabase — actinno project (oihpglvvzzmjigxrlmfz), Settings > API
# NOTE: this is a DIFFERENT project than meminno's — do not reuse meminno's Supabase keys here
SUPABASE_URL=https://oihpglvvzzmjigxrlmfz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — console.cloud.google.com, enable Gmail API, add yourself as OAuth test user
# (no app verification review needed at this scale — see ACT-006)
# Used by: Gmail verification listener (ACT-006)
#
# The OAuth client must be a Desktop app client (any loopback port is accepted),
# or a Web application client with http://localhost:53682/oauth/callback listed
# under Authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Minted by the one-time consent run:  cd lib && npm run gmail-auth
# Paste the value it prints here. Treat it like a password — it grants read
# access to the mailbox (scope: gmail.readonly).
#
# EXPIRES EVERY 7 DAYS. While the Google Cloud OAuth app stays in "Testing"
# publishing status — which is what lets this project skip Google's app
# verification review — Google expires a test user's refresh token 7 days after
# consent. When it does, `npm run verification-listener` stops with a banner
# naming the fix: re-run `npm run gmail-auth` and paste the new value here.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Inngest — where the ACT-006 listener sends `email/verification-received`, and
# where ACT-009's pipeline (inngest/serve.ts) registers its two functions.
#
# You do NOT normally need to set these: the committed `.env` already carries
# INNGEST_DEV=1, which is the right value for this repo's local-demo stage and
# is what both processes pick up. It is a committed default rather than a
# per-machine one because the v4 SDK does not infer dev mode from NODE_ENV —
# unset means Cloud, which then fails on the missing signing key.
#
# Set these here only to override that: INNGEST_DEV= (empty) plus an
# INNGEST_EVENT_KEY to talk to Inngest Cloud instead. `.env.local` is loaded
# before `.env` and dotenv never overwrites, so whatever is here wins.
INNGEST_DEV=
INNGEST_EVENT_KEY=
