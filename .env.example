# Copy to .env.local and fill in real values. .env.local is gitignored — never commit it.

# Apify — apify.com/settings/integrations
# Used by: bulk-search-job-listings (ACT-002, done), Playwright account creation (ACT-005)
APIFY_API_TOKEN=

# Supabase — actinno project (oihpglvvzzmjigxrlmfz), Settings > API
# NOTE: this is a DIFFERENT project than meminno's — do not reuse meminno's Supabase keys here
SUPABASE_URL=https://oihpglvvzzmjigxrlmfz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — console.cloud.google.com, enable Gmail API, add yourself as OAuth test user
# (no app verification review needed at this scale — see ACT-006)
# Used by: Gmail verification listener (ACT-006)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
