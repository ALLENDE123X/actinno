{
  "name": "actinno-mcp",
  "version": "0.1.0",
  "description": "Actinno local MCP server — consumer actor marketplace, search_actors/call_actor pattern",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "tsx index.ts",
    "bundle": "esbuild index.ts --bundle --platform=node --format=esm --target=node20 --outfile=$HOME/.actinno-mcp/server.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --lib es2023,dom *.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "inngest": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
