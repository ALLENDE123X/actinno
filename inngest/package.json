{
  "name": "actinno-inngest",
  "version": "0.1.0",
  "description": "ACT-009 orchestration — Inngest functions wiring ACT-002 through ACT-008 end to end",
  "type": "module",
  "scripts": {
    "serve": "tsx serve.ts",
    "dev": "inngest-cli dev -u http://localhost:3000/api/inngest --no-discovery",
    "trigger": "tsx trigger-cli.ts",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --lib es2023,dom *.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "inngest": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "inngest-cli": "^1.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
